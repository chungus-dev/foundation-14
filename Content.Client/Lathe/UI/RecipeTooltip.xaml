<Control xmlns="https://spacestation14.io"
         xmlns:gfx="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client"
         xmlns:xNamespace="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:palette="clr-namespace:Content.Client._Scp.Stylesheets.Palette"
         MaxWidth="400">
    <PanelContainer>
        <!-- Scp edit start - fix color hardcode -->
        <PanelContainer.PanelOverride>
            <gfx:StyleBoxFlat
                BorderThickness="2"
                BorderColor="{ xNamespace:Static palette:ScpPalettes.SCPWhite }"
                BackgroundColor="{ xNamespace:Static palette:ScpPalettes.PanelDarkWithAlpha75 }"
            />
        <!-- Scp edit end -->
        </PanelContainer.PanelOverride>
        <BoxContainer
            Orientation="Vertical"
            RectClipContent="True"
            Margin="4">
            <RichTextLabel Name="RecipeTooltipLabel" HorizontalExpand="True" />
        </BoxContainer>
    </PanelContainer>
</Control>
