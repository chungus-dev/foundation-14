preset raw;
light_mode unshaded;
blend_mode add;

#include "/Textures/_Scp/Shaders/directional_fov_shared.swsl"

uniform sampler2D shadowMask;
uniform sampler2D protectionMask;
uniform sampler2D lightMetadata;
uniform highp float metadataPixelSize;
// Converts viewport UV into the (possibly larger) transient atlas UV.
uniform highp vec2 shadowUvScale;
// Viewport-stable minimum screen-space centre (xy) and extent (zw). Metadata
// stores an affine UNORM coordinate so lights outside the viewport are not
// clamped without changing this uniform as the camera translates or PVS churns.
uniform highp vec4 lightCenterDecode;
// Softness, falloff, curve factor and protection-mask presence.
uniform highp vec4 lightGroupParameters;
uniform highp int directionalFovMode;
// Offset, view direction, radial parameters and cone thresholds.
uniform highp vec2[4] directionalFovParameters;

varying highp vec4 vertexLight;
varying highp vec2 vertexLightParameters;
varying highp vec4 vertexMetadata;

highp float decodeUint16(highp vec2 value)
{
    // Normalized texture channels are floating-point values. Round the rebuilt
    // integer so a biased zero offset remains exactly zero on every backend.
    return floor(dot(value, vec2(65280.0, 255.0)) + 0.5);
}

highp float decodeUnorm16(highp vec2 value)
{
    return decodeUint16(value) / 65535.0;
}

highp vec4 getLightMetadata(highp float firstTexelX)
{
    highp vec4 first = texture2D(lightMetadata, vec2(firstTexelX, 0.5));
    highp vec4 second = texture2D(
        lightMetadata,
        vec2(firstTexelX + metadataPixelSize, 0.5));
    highp vec2 atlasPixelSize = SCREEN_PIXEL_SIZE * shadowUvScale;
    return vec4(
        decodeUnorm16(first.rg),
        decodeUnorm16(first.ba),
        (decodeUint16(second.rg) - 32768.0) * atlasPixelSize.x,
        (decodeUint16(second.ba) - 32768.0) * atlasPixelSize.y);
}

void vertex()
{
    VERTEX = pixel_snap(apply_mvp(VERTEX));
    vertexLight = modulate;
    vertexLightParameters = tCoord2;
    // The metadata index is identical for all six vertices of a light. Fetching
    // here avoids two texture reads for every illuminated fragment.
    vertexMetadata = getLightMetadata(tCoord2.y);
}

highp vec2 clampSourceUv(highp vec2 uv)
{
    highp vec2 halfPixel = SCREEN_PIXEL_SIZE * 0.5;
    return clamp(uv, halfPixel, vec2(1.0) - halfPixel);
}

highp vec3 sampleMask7(
    sampler2D maskTexture,
    highp vec2 sourceUv,
    highp vec2 atlasOffset,
    highp vec2 sampleOffset)
{
    highp vec2 atlasUv = clampSourceUv(sourceUv) * shadowUvScale + atlasOffset;

    if (lightGroupParameters[0] <= 0.0)
        return zTextureSpec(maskTexture, atlasUv).rgb;

    highp vec3 value = zTextureSpec(maskTexture, atlasUv).rgb * (20.0 / 64.0);
    value += zTextureSpec(
        maskTexture,
        clampSourceUv(sourceUv + sampleOffset) * shadowUvScale + atlasOffset).rgb * (15.0 / 64.0);
    value += zTextureSpec(
        maskTexture,
        clampSourceUv(sourceUv - sampleOffset) * shadowUvScale + atlasOffset).rgb * (15.0 / 64.0);
    value += zTextureSpec(
        maskTexture,
        clampSourceUv(sourceUv + sampleOffset * 2.0) * shadowUvScale + atlasOffset).rgb * (6.0 / 64.0);
    value += zTextureSpec(
        maskTexture,
        clampSourceUv(sourceUv - sampleOffset * 2.0) * shadowUvScale + atlasOffset).rgb * (6.0 / 64.0);
    value += zTextureSpec(
        maskTexture,
        clampSourceUv(sourceUv + sampleOffset * 3.0) * shadowUvScale + atlasOffset).rgb * (1.0 / 64.0);
    value += zTextureSpec(
        maskTexture,
        clampSourceUv(sourceUv - sampleOffset * 3.0) * shadowUvScale + atlasOffset).rgb * (1.0 / 64.0);
    return value;
}

mediump float getDirectionalFovOcclusion(highp vec2 fragmentCoords)
{
    if (directionalFovMode == 0)
        return 0.0;

    highp vec2 targetSize = vec2(
        1.0 / SCREEN_PIXEL_SIZE.x,
        1.0 / SCREEN_PIXEL_SIZE.y);
    highp vec2 finalCoords = fragmentCoords - directionalFovParameters[0];
    return scpDirectionalFovOcclusionMask(
        targetSize,
        finalCoords,
        directionalFovParameters[1],
        directionalFovParameters[2],
        directionalFovParameters[3]);
}

mediump float getShadowVisibility(highp vec2 screenUv, highp vec2 fragmentCoords)
{
    highp vec2 atlasOffset = vertexMetadata.zw;

    highp vec2 lightCenter =
        lightCenterDecode.xy + vertexMetadata.xy * lightCenterDecode.zw;
    highp vec2 fromLight = screenUv - lightCenter;
    highp vec2 perpendicular = vec2(1.0, 0.0);
    if (dot(fromLight, fromLight) > 0.0000001)
        perpendicular = normalize(vec2(-fromLight.y, fromLight.x));

    highp vec2 softOffset = perpendicular * SCREEN_PIXEL_SIZE * lightGroupParameters[0];
    highp vec3 masks = sampleMask7(
        shadowMask,
        screenUv,
        atlasOffset,
        softOffset);
    mediump float directionalOcclusion = getDirectionalFovOcclusion(fragmentCoords);
    mediump float caster = mix(masks.r, masks.g, directionalOcclusion);

    if (lightGroupParameters[3] > 0.0)
    {
        mediump float protection = zTextureSpec(protectionMask, screenUv).r;
        caster *= 1.0 - clamp(protection, 0.0, 1.0);
    }

    mediump float casterVisibility = 1.0 - clamp(caster, 0.0, 1.0);
    mediump float occluderVisibility = 1.0 - clamp(masks.b, 0.0, 1.0);
    return casterVisibility * occluderVisibility;
}

void fragment()
{
    highp float pointLightMask = zTexture(UV).r;
    if (pointLightMask <= 0.0)
        discard;

    highp vec2 screenUv = FRAGCOORD.xy * SCREEN_PIXEL_SIZE;
    mediump float shadowVisibility = getShadowVisibility(screenUv, FRAGCOORD.xy);
    if (shadowVisibility <= 0.0)
        discard;

    highp float lightRange = vertexLightParameters.x;
    highp vec2 diff = (UV - vec2(0.5)) * (2.0 * lightRange);
    highp float squareDistance = dot(diff, diff) + 1.0;
    highp float relativeDistance = clamp(sqrt(squareDistance) / lightRange, 0.0, 1.0);
    highp float relativeDistanceSquared = relativeDistance * relativeDistance;
    highp float curve = mix(
        relativeDistance,
        relativeDistanceSquared,
        clamp(lightGroupParameters[2], 0.0, 1.0));
    highp float strength = clamp(
        ((1.0 - relativeDistanceSquared) * (1.0 - relativeDistanceSquared)) /
        (1.0 + lightGroupParameters[1] * curve),
        0.0,
        1.0);

    strength *= vertexLight.a * pointLightMask * shadowVisibility;
    if (strength <= 0.0)
        discard;

    COLOR = vec4(vertexLight.rgb, strength);
}
