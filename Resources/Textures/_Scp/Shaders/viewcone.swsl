#include "/Textures/_Scp/Shaders/directional_fov_shared.swsl"

uniform sampler2D BLURRED_TEXTURE;
uniform mediump float coneOpacity;

uniform sampler2D SCREEN_TEXTURE;
// Offset, view direction, radial parameters and cone thresholds.
uniform highp vec2[4] directionalFovParameters;

void fragment(){
    highp vec2 pixelSize = vec2(1.0 / SCREEN_PIXEL_SIZE.x, 1.0 / SCREEN_PIXEL_SIZE.y);
    mediump vec4 color = texture(SCREEN_TEXTURE, UV);
    highp vec2 finalCoords = FRAGCOORD.xy - directionalFovParameters[0];

    mediump float mask = scpDirectionalFovOcclusionMask(
        pixelSize,
        finalCoords,
        directionalFovParameters[1],
        directionalFovParameters[2],
        directionalFovParameters[3]);

    mediump vec4 blurredColor = texture(BLURRED_TEXTURE, UV);
    mediump vec4 outOfFovColor = mix(blurredColor, vec4(0.0, 0.0, 0.0, 1.0), coneOpacity);

    COLOR = vec4(mix(color.rgb, outOfFovColor.rgb, mask), color.a);
}
