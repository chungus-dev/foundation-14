preset raw;
light_mode unshaded;

varying lowp float vertexAlpha;
varying mediump vec2 vertexOwner;

void vertex()
{
    VERTEX = pixel_snap(apply_mvp(VERTEX));
    vertexAlpha = modulate.a;
    vertexOwner = modulate.rg;
}

void fragment()
{
    if (zTexture(UV).a * vertexAlpha < 0.1)
        discard;

    COLOR = vec4(vertexOwner, 0.0, 1.0);
}
