// Returns how strongly the directional SCP FOV hides a screen pixel:
// 0.0 is visible and 1.0 is fully outside the visible cone.
mediump float scpDirectionalFovOcclusionMask(
    highp vec2 pixelSize,
    highp vec2 finalCoords,
    highp vec2 viewDirection,
    highp vec2 radialParameters,
    highp vec2 coneThresholds)
{
    mediump float mask = 1.0;
    mediump float radial = zCircleGradient(
        pixelSize,
        finalCoords,
        1.0,
        radialParameters.x,
        radialParameters.y,
        1.0);
    mask -= radial;

    highp vec2 fromCenter = finalCoords - (pixelSize * 0.5);
    highp vec2 delta = vec2(0.0, -1.0);
    if (dot(fromCenter, fromCenter) > 0.0000001)
        delta = normalize(fromCenter);

    mediump float cosDelta = dot(delta, viewDirection);
    mediump float deltaAngle = smoothstep(
        coneThresholds.x,
        coneThresholds.y,
        cosDelta);

    mask += clamp(deltaAngle, 0.0, 1.0);
    return 1.0 - clamp(mask, 0.0, 1.0);
}
